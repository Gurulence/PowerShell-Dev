{
  "$schema": "./agent.config.schema.json",
  "provider": {
    "name": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "model": "gpt-4.1",
    "apiKeyEnv": "OPENAI_API_KEY",
    "apiKeyHeader": "Authorization",
    "apiKeyPrefix": "Bearer ",
    "extraHeaders": {},
    "temperature": 0.2,
    "maxTokens": 4096,
    "maxTokensParam": "max_tokens",
    "requestTimeoutSec": 240,
    "maxRetries": 3
  },
  "agent": {
    "mode": "hybrid",
    "maxTurns": 40,
    "maxContextChars": 120000,
    "approvalGate": "all",
    "allowOutsideWorkspace": false,
    "commandTimeoutSec": 300,
    "maxToolOutputChars": 12000,
    "logDir": ".agent/logs",
    "sessionDir": ".agent/sessions",
    "todoFile": ".agent/todo.md",
    "pwshPath": "pwsh",
    "windowsPowerShellPath": "powershell",
    "posixShell": "/bin/bash",
    "dotnetPath": "dotnet",
    "gitPath": "git",
    "denyPatterns": [
      "Remove-Item\\s+.*-Recurse.*-Force\\s+.*[\\\\/]\\s*$",
      "\\brm\\s+-rf?\\s+/(\\s|$)",
      "\\bformat\\s+[a-zA-Z]:",
      "\\bdiskpart\\b",
      "Remove-Item\\s+.*(C:\\\\Windows|\\$env:SystemRoot)",
      "Set-ItemProperty\\s+.*HKLM:",
      "reg\\s+delete\\s+HKLM",
      "\\bgit\\s+push\\s+.*--force",
      "\\bgit\\s+reset\\s+--hard",
      "Invoke-Expression\\s*\\(.*Invoke-WebRequest",
      "\\bcurl\\b.*\\|\\s*(ba)?sh"
    ]
  }
}
