// Recommended keybindings for the agent workflow.
// Merge into your VS Code keybindings.json (Ctrl+Shift+P > "Preferences: Open Keyboard Shortcuts (JSON)").
[
  {
    "key": "ctrl+alt+a",
    "command": "workbench.action.tasks.runTask",
    "args": "Agent: run task (approve every step)",
    "when": "editorTextFocus || terminalFocus || explorerViewletVisible"
  },
  {
    "key": "ctrl+alt+shift+a",
    "command": "workbench.action.tasks.runTask",
    "args": "Agent: run task in a mode"
  },
  {
    "key": "ctrl+alt+d",
    "command": "workbench.action.tasks.runTask",
    "args": "Agent: dry run (no execution, no API call)"
  },
  {
    "key": "ctrl+alt+r",
    "command": "workbench.action.tasks.runTask",
    "args": "Agent: resume last session"
  },
  {
    "key": "ctrl+alt+h",
    "command": "workbench.action.tasks.runTask",
    "args": "Agent: doctor (verify environment)"
  },
  {
    "key": "ctrl+alt+p",
    "command": "workbench.action.tasks.runTask",
    "args": "PS: analyse workspace"
  },
  {
    "key": "ctrl+alt+5",
    "command": "workbench.action.tasks.runTask",
    "args": "PS: analyse + verify 5.1 syntax compatibility"
  },
  {
    "key": "ctrl+alt+t",
    "command": "workbench.action.tasks.runTask",
    "args": "PS: run Pester"
  },
  {
    "key": "ctrl+alt+b",
    "command": "workbench.action.tasks.runTask",
    "args": "NET: build"
  },
  {
    "key": "ctrl+alt+shift+t",
    "command": "workbench.action.tasks.runTask",
    "args": "NET: test"
  },

  // Quick access to the files you look at most while reviewing agent work
  {
    "key": "ctrl+alt+m",
    "command": "vscode.open",
    "args": ["${workspaceFolder}/.agent/todo.md"]
  },
  {
    "key": "ctrl+alt+j",
    "command": "vscode.open",
    "args": ["${workspaceFolder}/.agent/sessions"]
  },

  // Handy while writing PowerShell
  {
    "key": "ctrl+alt+n",
    "command": "PowerShell.ShowSessionMenu"
  },
  {
    "key": "ctrl+alt+s",
    "command": "PowerShell.RunSelection",
    "when": "editorTextFocus && editorLangId == 'powershell'"
  }
]
